rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function workspaceId() {
      return 'budgesty_2027_principal';
    }

    function isWorkspace(userId) {
      return userId == workspaceId();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMoisId(moisId) {
      return moisId is string && moisId.size() == 7 && moisId.matches('^2027-(0[1-9]|1[0-2])$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 8 && t.matches('^\\d{2}:\\d{2}:\\d{2}$');
    }

    function isBoundedInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    // --- Entity Validators ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == workspaceId() && data.userId.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalaireMap(s) {
      return s is map
        && s.size() == 10
        && s.salaireReference == 155000
        && s.montantARecevoir is int && s.montantARecevoir >= 0 && s.montantARecevoir <= 50000000
        && s.bonus is int && s.bonus >= 0 && s.bonus <= 50000000
        && s.motifModification is string && s.motifModification.size() <= 200
        && s.alimentee is bool
        && s.montantActif is int && s.montantActif >= 0 && s.montantActif <= 155000
        && s.argentEncoreDisponible is int && s.argentEncoreDisponible >= 0 && s.argentEncoreDisponible <= s.montantActif
        && s.excedentTransfere is int && s.excedentTransfere >= 0 && s.excedentTransfere <= 50000000;
    }

    function isValidLoyerMap(l) {
      return l is map
        && l.size() == 4
        && l.montant == 35350
        && l.paye is bool
        && l.payeLe is string && l.payeLe.size() <= 40;
    }

    function isValidFixesMap(f) {
      return f is map
        && f.size() == 5
        && f.epargne.montant == 40000
        && f.soutien_famille.montant == 30000
        && f.don_papa.montant == 10000
        && f.femme_enfant.montant == 20000
        && f.eau_boire.montant == 2000;
    }

    function isValidDepensesCategoriesMap(dc) {
      return dc is map
        && dc.size() == 3
        && dc.maison.budgetAlloue == 30000 && dc.maison.depenseCumulee is int && dc.maison.depenseCumulee >= 0 && dc.maison.depenseCumulee <= 30000
        && dc.internet.budgetAlloue == 5000 && dc.internet.depenseCumulee is int && dc.internet.depenseCumulee >= 0 && dc.internet.depenseCumulee <= 5000
        && dc.eau_laver.budgetAlloue == 1000 && dc.eau_laver.depenseCumulee is int && dc.eau_laver.depenseCumulee >= 0 && dc.eau_laver.depenseCumulee <= 1000;
    }

    function isValidCaissesMap(cs) {
      return cs is map
        && cs.size() == 5
        && cs.sante.dotationMensuelle == 5000 && cs.sante.soldeActuel is int && cs.sante.soldeActuel >= 0
        && cs.vetements.dotationMensuelle == 7000 && cs.vetements.soldeActuel is int && cs.vetements.soldeActuel >= 0
        && cs.secours.dotationMensuelle == 5000 && cs.secours.soldeActuel is int && cs.secours.soldeActuel >= 0
        && cs.epargne.dotationMensuelle == 0 && cs.epargne.soldeActuel is int && cs.epargne.soldeActuel >= 0
        && cs.surplus.dotationMensuelle == 0 && cs.surplus.soldeActuel is int && cs.surplus.soldeActuel >= 0;
    }

    function isValidBudgetMonth(data, userId, moisId) {
      return data.keys().hasAll([
          'userId', 'moisId', 'ordre', 'label', 'cycleLabel', 'cycleDebut', 'cycleFin',
          'statut', 'salaire', 'loyer', 'fixes', 'depensesCategories', 'caisses',
          'clotureLe', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'moisId', 'ordre', 'label', 'cycleLabel', 'cycleDebut', 'cycleFin',
          'statut', 'salaire', 'loyer', 'fixes', 'depensesCategories', 'caisses',
          'clotureLe', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.moisId == moisId
        && isBoundedInt(data.ordre, 1, 12)
        && data.label is string && data.label.size() <= 40
        && data.cycleLabel is string && data.cycleLabel.size() <= 60
        && data.cycleDebut is string && data.cycleDebut.size() == 10
        && data.cycleFin is string && data.cycleFin.size() == 10
        && data.statut in ['OUVERT', 'VERROUILLE', 'CLOTURE']
        && isValidSalaireMap(data.salaire)
        && isValidLoyerMap(data.loyer)
        && isValidFixesMap(data.fixes)
        && isValidDepensesCategoriesMap(data.depensesCategories)
        && isValidCaissesMap(data.caisses)
        && data.clotureLe is string && data.clotureLe.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function respectsIrreversibility(next, prev) {
      return (!prev.salaire.alimentee || (next.salaire.alimentee && next.salaire.montantActif == prev.salaire.montantActif && next.salaire.excedentTransfere == prev.salaire.excedentTransfere))
        && (next.salaire.alimentee || (!next.loyer.paye && !next.fixes.epargne.valide && !next.fixes.soutien_famille.valide && !next.fixes.don_papa.valide && !next.fixes.femme_enfant.valide && !next.fixes.eau_boire.valide && !next.caisses.sante.dotationAlimentee && !next.caisses.vetements.dotationAlimentee && !next.caisses.secours.dotationAlimentee))
        && (!prev.loyer.paye || next.loyer.paye)
        && (!prev.fixes.epargne.valide || next.fixes.epargne.valide)
        && (!prev.fixes.soutien_famille.valide || next.fixes.soutien_famille.valide)
        && (!prev.fixes.don_papa.valide || next.fixes.don_papa.valide)
        && (!prev.fixes.femme_enfant.valide || next.fixes.femme_enfant.valide)
        && (!prev.fixes.eau_boire.valide || next.fixes.eau_boire.valide)
        && (!prev.depensesCategories.maison.cloturee || next.depensesCategories.maison.cloturee)
        && (!prev.depensesCategories.internet.cloturee || next.depensesCategories.internet.cloturee)
        && (!prev.depensesCategories.eau_laver.cloturee || next.depensesCategories.eau_laver.cloturee)
        && (!prev.caisses.sante.dotationAlimentee || next.caisses.sante.dotationAlimentee)
        && (!prev.caisses.vetements.dotationAlimentee || next.caisses.vetements.dotationAlimentee)
        && (!prev.caisses.secours.dotationAlimentee || next.caisses.secours.dotationAlimentee);
    }

    function isValidExpenseEntry(data, userId, moisId) {
      return data.keys().hasAll(['userId', 'moisId', 'categorieId', 'date', 'montant', 'description', 'note', 'createdAt'])
        && data.keys().hasOnly(['userId', 'moisId', 'categorieId', 'date', 'montant', 'description', 'note', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId == workspaceId() && data.userId.size() <= 128
        && data.moisId is string && data.moisId == moisId && isValidMoisId(data.moisId)
        && data.categorieId in ['maison', 'internet', 'eau_laver']
        && isValidDateStr(data.date)
        && isBoundedInt(data.montant, 1, 155000)
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 140
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidHistoryEntry(data, userId) {
      return data.keys().hasAll([
          'userId', 'moisId', 'moisLabel', 'dateOperation', 'heureOperation',
          'type', 'categorie', 'montant', 'motif', 'soldeAvant', 'soldeApres', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'moisId', 'moisLabel', 'dateOperation', 'heureOperation',
          'type', 'categorie', 'montant', 'motif', 'soldeAvant', 'soldeApres', 'createdAt'
        ])
        && data.userId is string && data.userId == userId && data.userId == workspaceId() && data.userId.size() <= 128
        && isValidMoisId(data.moisId)
        && data.moisLabel is string && data.moisLabel.size() >= 1 && data.moisLabel.size() <= 40
        && isValidDateStr(data.dateOperation)
        && isValidTimeStr(data.heureOperation)
        && data.type in [
          'MODIFICATION_SALAIRE', 'ALIMENTATION_SALAIRE', 'BONUS_SALAIRE',
          'TRANSFERT_AUTO_SURPLUS', 'PAIEMENT_LOYER', 'VALIDATION_FIXE',
          'AJOUT_DEPENSE', 'CLOTURE_DEPENSE', 'ALIMENTATION_CAISSE',
          'RETRAIT_CAISSE', 'TRANSFERT_CAISSE_SURPLUS', 'TRANSFERT_SURPLUS_CAISSE',
          'RETRAIT_SURPLUS', 'CLOTURE_MOIS'
        ]
        && data.categorie is string && data.categorie.size() >= 1 && data.categorie.size() <= 60
        && isBoundedInt(data.montant, 0, 100000000)
        && data.motif is string && data.motif.size() >= 1 && data.motif.size() <= 240
        && isBoundedInt(data.soldeAvant, 0, 500000000)
        && isBoundedInt(data.soldeApres, 0, 500000000)
        && data.createdAt is timestamp;
    }

    // --- Collection Rules (Espace direct sans fournisseur d'authentification) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isWorkspace(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isWorkspace(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isWorkspace(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /mois/{moisId} {
        allow get: if isValidId(userId) && isValidMoisId(moisId) && isWorkspace(userId);
        allow list: if isValidId(userId) && isWorkspace(userId) && resource.data.userId == workspaceId();
        allow create: if isValidId(userId)
          && isValidMoisId(moisId)
          && isWorkspace(userId)
          && isValidBudgetMonth(incoming(), userId, moisId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidMoisId(moisId)
          && isWorkspace(userId)
          && isValidBudgetMonth(incoming(), userId, moisId)
          && existing().statut != 'CLOTURE'
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().statut == 'VERROUILLE'
              && incoming().statut == 'OUVERT'
              && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'caisses', 'updatedAt'])
            )
            ||
            (
              existing().statut == 'OUVERT'
              && incoming().statut == 'OUVERT'
              && respectsIrreversibility(incoming(), existing())
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'salaire', 'loyer', 'fixes', 'depensesCategories', 'caisses', 'updatedAt'
              ])
            )
            ||
            (
              existing().statut == 'OUVERT'
              && incoming().statut == 'CLOTURE'
              && incoming().clotureLe.size() >= 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'clotureLe', 'updatedAt'])
            )
          );
        allow delete: if false;

        match /depenses/{depenseId} {
          allow get: if isValidId(userId) && isValidMoisId(moisId) && isValidId(depenseId) && isWorkspace(userId);
          allow list: if isValidId(userId) && isValidMoisId(moisId) && isWorkspace(userId) && resource.data.userId == workspaceId();
          allow create: if isValidId(userId)
            && isValidMoisId(moisId)
            && isValidId(depenseId)
            && isWorkspace(userId)
            && isValidExpenseEntry(incoming(), userId, moisId)
            && incoming().createdAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(userId)/mois/$(moisId)).data.statut == 'OUVERT';
          allow update, delete: if false;
        }
      }

      match /historique/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isWorkspace(userId);
        allow list: if isValidId(userId) && isWorkspace(userId) && resource.data.userId == workspaceId();
        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isWorkspace(userId)
          && isValidHistoryEntry(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
